# Every variable the site reads (checked against the code 2026-11-12).
# Local: copy to .env.local. Vercel: Project → Settings → Environment Variables (Production, Preview, Development).
# NEXT_PUBLIC_* values are built into the browser code: change them → redeploy. Everything else stays on the server.

# ── Supabase (required) ── project → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only (Discord reminders dedupe, server routes): the secret / service_role key. Mark it Sensitive on Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ── Site sign-in roles (required) ── viewer (none) < power < officer < admin
# NEXT_PUBLIC: anyone can read them in the browser code; they only gate the UI, the data is protected by Supabase RLS.
NEXT_PUBLIC_ADMIN_PASSWORD=your-admin-password
NEXT_PUBLIC_OFFICER_PASSWORD=your-officer-password
NEXT_PUBLIC_POWER_PASSWORD=your-power-user-password

# ── Discord reminders: /api/discord/kvk-alerts, called every 5 min by Supabase pg_cron (lib/supabase/migrations/discord-kvk-alerts.sql) ──
# A long random string; the same value goes into the Supabase Vault secret 'discord_kvk_cron_secret'.
CRON_SECRET=a-long-random-string
# Discord channel → Edit Channel → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_KINGDOM=https://discord.com/api/webhooks/...
# Optional: AoO alerts channel (falls back to DISCORD_WEBHOOK_KINGDOM)
DISCORD_WEBHOOK_ANGMAR=
# Optional: "everyone" (default), "none", or a role id
DISCORD_KINGDOM_MENTION=
# Optional: role ids for AoO teams 1,2,3 as "id1,id2,id3" (one id = same role for every team; empty = no ping)
DISCORD_AOO_ROLE_IDS=

# ── RoK Mail AI writer (optional) ── https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Roboflow commander scanner (optional) ── https://app.roboflow.com/settings/api
NEXT_PUBLIC_ROBOFLOW_API_KEY=
NEXT_PUBLIC_ROBOFLOW_WORKSPACE=roksuite
NEXT_PUBLIC_ROBOFLOW_WORKFLOW=find-stars-commander-names-commander-portraits-level-badges-and-skill-icons
NEXT_PUBLIC_ROBOFLOW_PROJECT=rok-commander-scanner-rbbb5
NEXT_PUBLIC_ROBOFLOW_MODEL_VERSION=1
